#Generate CA Certificate

openssl genrsa -out ca-key.pem 2048
openssl req -new -x509 -key ca-key.pem -out ca-cert.pem -days 365
#Generate Server Certificate

openssl req -newkey rsa:2048 -nodes -keyout server-key.pem -out server-req.pem
openssl x509 -req -in server-req.pem -CA ca-cert.pem -CAkey ca-key.pem -CAcreateserial -out server-cert.pem -days 365
#Generate Client Certificate

openssl req -newkey rsa:2048 -nodes -keyout client-key.pem -out client-req.pem
openssl x509 -req -in client-req.pem -CA ca-cert.pem -CAkey ca-key.pem -CAcreateserial -out client-cert.pem -days 365

# Use a Kubernetes Secret for Certificates
kubectl create secret generic mysql-certs -n myapps \
  --from-file=ca-cert.pem \
  --from-file=server-cert.pem \
  --from-file=server-key.pem

 #Secret for MySQL Client Certificates

 kubectl create secret generic mysql-client-certs -n myapps \
  --from-file=ca-cert.pem \
  --from-file=client-cert.pem \
  --from-file=client-key.pem
 #Download Istio: 
 curl -L https://istio.io/downloadIstio | sh -
cd istio-*
export PATH=$PWD/bin:$PATH  
istioctl install --set profile=demo -y
kubectl get pods -n istio-system
kubectl label namespace myapps istio-injection=enabled
kubectl get namespace myapps --show-labels

kubectl rollout restart deployment/my-app-backend -n myapps
kubectl rollout restart deployment/my-app-db -n myapps